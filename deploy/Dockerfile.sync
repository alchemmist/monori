# sync: the bank-sync service — connectors, Playwright and Chromium live here,
# isolated from the API. Internal network only; stores nothing on disk.
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY common ./common
COPY ci/pyproject.toml ./ci/pyproject.toml
COPY server ./server
RUN pip install --no-cache-dir "uv==0.11.26" && \
    uv sync --frozen --group sync-runtime --no-dev && \
    .venv/bin/playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*
EXPOSE 8010
CMD [".venv/bin/uvicorn", "monori.server.app.sync_service:app", "--host", "0.0.0.0", "--port", "8010"]
