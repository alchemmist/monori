# back: the API only — no static files, no Playwright. Bank syncs are
# delegated to the sync service via MONORI_SYNC_URL.
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY __init__.py ./
COPY common ./common
COPY ci ./ci
COPY server ./server
RUN pip install --no-cache-dir "uv==0.11.26" && \
    uv sync --frozen --group runtime --no-dev
ENV MONORI_DB=/app/data/monori.db
EXPOSE 8000
# on SIGTERM uvicorn stops accepting connections and finishes what is already
# running, so a redeploy never cuts a long import short; the compose
# stop_grace_period must stay at least this generous
CMD [".venv/bin/uvicorn", "monori.server.app.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--timeout-graceful-shutdown", "600"]
